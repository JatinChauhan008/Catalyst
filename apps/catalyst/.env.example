# Copy this file to .env and fill in the values. .env is not committed.

# Sarvam API subscription key. With a key, Sarvam is the default OCR engine
# for PDF and image files.
SARVAM_API_KEY=

# Optional server settings (defaults shown).
# CATALYST_MAX_UPLOAD_MB=200
# CATALYST_KEEP_JOBS=200
# Sarvam price per page, used for the cost on the History page.
# CATALYST_SARVAM_PRICE_PER_PAGE=0.5
# CATALYST_SARVAM_CURRENCY=INR
